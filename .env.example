# Projekt-Umgebungsvariablen
# Kopiere diese Datei zu .env.local und fülle die Werte aus

# GitHub (für MCP-Server)
GITHUB_TOKEN=                 # Fine-grained Token, nur für die nötigen Repos

# Datenbank
DATABASE_URL=                 # PostgreSQL Connection String

# Authentifizierung (API)
JWT_SECRET=                   # Zufälliger String: openssl rand -base64 32
APP_URL=                      # Basis-URL (z.B. https://app.example.com)

# Optionale MCP-Server (bei Bedarf aktivieren)
# FIGMA_TOKEN=               # Figma Personal Access Token
# SUPABASE_ACCESS_TOKEN=     # Supabase Personal Access Token
